# Storage backend used by the API.
# Use file mode on a small Windows laptop. Change to postgres later for VPS/autotrading.
SB_STORAGE=file
SB_DATA_DIR=data/market
SB_FILE_FORMAT=csv.gz
SB_UPDATE_INTERVAL_MINUTES=5

# PostgreSQL connection used only when SB_STORAGE=postgres.
# Example for local Postgres:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sb_system
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sb_system

# Default MT5 import settings. Override inside the notebook if needed.
SB_SYMBOLS=EURUSD,GBPUSD,USDJPY,XAUUSD+,NAS100.r,SP500.r
SB_TIMEFRAMES=M1,M5,M15,H1,H4,D1
SB_IMPORT_START=2026-01-01
