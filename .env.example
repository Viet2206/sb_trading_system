# PostgreSQL is the primary store. Set SB_STORAGE=file only for a lightweight fallback.
SB_STORAGE=postgres
SB_DATA_SOURCE=mt5
SB_DATA_DIR=data/market
SB_FILE_FORMAT=csv.gz
SB_UPDATE_INTERVAL_MINUTES=5
SB_API_HOST=0.0.0.0
SB_API_PORT=8010
SB_HISTORY_MONTHS=3

# Research library and evidence-backed AI. Local search works without an API key.
SB_RESEARCH_DOCS_DIR=docs
SB_RESEARCH_INDEX=data/research/research.sqlite3
SB_RESEARCH_PAGE_CACHE=data/research/pages
SB_EMBEDDING_PROVIDER=local
SB_AI_PROVIDER=zai
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4.7
ZAI_VISION_MODEL=glm-4.6v-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Telegram notifications. Signals remain disabled until their rules are validated.
SB_TELEGRAM_ENABLED=false
SB_TELEGRAM_BOT_TOKEN=
SB_TELEGRAM_CHAT_ID=
SB_TELEGRAM_API_BASE_URL=https://api.telegram.org
SB_TELEGRAM_TIMEOUT_SECONDS=10

# Optional Web UI API target. Leave unset for same-host access through Tailscale.
# VITE_API_BASE_URL=http://127.0.0.1:8010

# Set both values to the same password before the first production startup.
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sb_system

# cTrader Open API settings. Create an app at https://openapi.ctrader.com/ and paste credentials here.
CTRADER_HOST_TYPE=demo
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=http://localhost
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_ACCOUNT_ID=
CTRADER_SYMBOLS=EURUSD,GBPUSD,USDJPY,AUDUSD,XAUUSD,NAS100,SP500
CTRADER_TIMEFRAMES=M5,M15,H1,H4,D1
CTRADER_IMPORT_START=2026-01-01

# MT5 import settings.
# SB_HISTORY_MONTHS controls the rolling import start; leave it empty to use SB_IMPORT_START.
SB_SYMBOLS=EURUSD,GBPUSD,USDJPY,AUDUSD,NZDUSD,USDCAD,XAUUSD.pc,NAS100,BTCUSD.sc,USDCHF.pc,GBPJPY.pc,EURJPY.pc,SP500,AUDCAD.pc,AUDCHF.pc,AUDJPY.pc,CADCHF.pc,CADJPY.pc,CHFJPY.pc,COPPER-C,EURAUD.pc,EURCAD.pc,EURCHF.pc,EURGBP.pc,GBPAUD.pc,GBPCAD.pc,GBPCHF.pc,USOUSD.pc
SB_TIMEFRAMES=M5,M15,H1,H4,D1
SB_IMPORT_START=2026-01-01
